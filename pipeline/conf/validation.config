/*
 * Validation profile — full-chr20 hap.py benchmark at representative depth (Phase 3,
 * ADR-0032). Real GIAB data on a single laptop (8 CPUs / 8 GB Docker VM, amd64 images
 * under emulation on arm64), so it lifts the default 2 h task ceiling: HaplotypeCaller
 * alone walks all of chr20 single-threaded.
 *
 *   nextflow run main.nf -profile validation,docker                       # full chr20, ~35x
 *   nextflow run main.nf -profile validation,docker \
 *       --input assets/samplesheet.window_35x.csv \
 *       --intervals chr20:1000000-2000000 \
 *       --truth_bed assets/truth/HG002_GRCh38_chr20_v4.2.1_window.bed     # 1 Mb window, ~35x
 *
 * Inputs are produced by scripts/downsample_giab_bam.sh from the GIAB
 * HG002.GRCh38.300x_chr20.bam — see docs/VALIDATION.md §2.
 */

params {
    input      = "${projectDir}/assets/samplesheet.full_chr20_35x.csv"
    intervals  = 'chr20'

    max_cpus   = 8
    max_memory = 7.GB
    max_time   = 48.h
}

process {
    time = { 12.h * task.attempt }

    withLabel:process_low    { cpus = 1; memory = 2.GB }
    withLabel:process_medium { cpus = 4; memory = 6.GB }
    withLabel:process_high   { cpus = 8; memory = 6.GB }

    withName:HAPLOTYPECALLER { time = 48.h }
}
