/*
 * AWS profile — metadata and storage only (ADR-0017, ADR-0018).
 *
 * Real compute runs LOCALLY. This profile publishes results to the S3 data lake and
 * enables metadata ingest. It deliberately sets no executor: the platform provisions
 * no cloud execution substrate (REQ-cost-guardrails).
 *
 *   export CGP_S3_BUCKET=...   CGP_DB_URL=...
 *   nextflow run main.nf -profile docker,aws
 */

params {
    db_ingest = true
    outdir    = "s3://${System.getenv('CGP_S3_BUCKET')}/results"
}

aws {
    region = System.getenv('AWS_REGION') ?: 'ap-southeast-2'
}
